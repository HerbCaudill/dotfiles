{
  "autoUpdatesChannel": "latest",
  "enabledPlugins": {
    "vercel@claude-plugins-official": false
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js"
  }
}