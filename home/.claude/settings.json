{
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js"
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "beads@herbcaudill": true
  },
  "extraKnownMarketplaces": {
    "herbcaudill": {
      "source": {
        "source": "git",
        "url": "https://github.com/HerbCaudill/plugins.git"
      }
    }
  },
  "skillOverrides": {
    "gws-calendar-agenda": "off",
    "gws-calendar-insert": "off",
    "gws-docs-write": "off",
    "gws-drive-upload": "off",
    "gws-gmail-forward": "off",
    "gws-gmail-read": "off",
    "gws-sheets-append": "off",
    "gws-sheets-read": "off"
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
