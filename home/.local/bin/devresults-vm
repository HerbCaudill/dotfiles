#!/usr/bin/env -S node --experimental-strip-types

import { runOpenDevresultsWorkspace } from "../../../scripts/windows-devresults/runOpenDevresultsWorkspace.ts"

runOpenDevresultsWorkspace().catch(error => {
  console.error(
    `[devresults-vm] ${error instanceof Error ? error.message : String(error)}`,
  )
  process.exitCode = 1
})
