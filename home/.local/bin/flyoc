#!/usr/bin/env node

/**
 * Provision and configure OpenClaw on Fly.io.
 *
 * 1. Creates Fly app + volume (if needed)
 * 2. Sets API key secrets
 * 3. Deploys the OpenClaw container
 * 4. Runs setup.ts (dev environment) on the VM
 * 5. Clones marvin-bootstrap and runs bootstrap.ts (OpenClaw config + state)
 *
 * Usage:
 *   flyoc              # full setup (idempotent, skips unchanged steps)
 *   flyoc --redeploy   # skip app/volume creation, just redeploy
 *   flyoc --new-token  # generate a fresh gateway token
 */

import { execSync } from "node:child_process"
import { existsSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs"
import { join } from "node:path"
import { tmpdir } from "node:os"

const HOME = process.env.HOME
const APP_NAME = "herbcaudill-marvin"
const REGION = "cdg"
const VOLUME_NAME = "openclaw_data"
const VOLUME_SIZE_GB = 1
const IMAGE = "ghcr.io/openclaw/openclaw:latest"
const FLY = join(HOME, ".fly", "bin", "fly")
const GATEWAY_URL = `https://${APP_NAME}.fly.dev`

const DEV_SETUP_URL =
  "https://raw.githubusercontent.com/HerbCaudill/dotfiles/main/scripts/setup.ts"
const BOOTSTRAP_REPO = "https://github.com/HerbCaudill/marvin-bootstrap.git"

const redeployOnly = process.argv.includes("--redeploy")
const freshToken = process.argv.includes("--new-token")

// Utilities

/** Read secrets from ~/.secrets, parsing `export KEY="value"` lines. Strips `xx_` prefix. */
function readSecrets() {
  const secretsPath = join(HOME, ".secrets")
  if (!existsSync(secretsPath)) return {}
  const content = readFileSync(secretsPath, "utf-8")
  const result = {}
  for (const line of content.split("\n")) {
    const match = line.match(/^export\s+(\w+)=["']?(.+?)["']?\s*$/)
    if (match) {
      const key = match[1].replace(/^xx_/, "")
      result[key] = match[2]
    }
  }
  return result
}

/** Execute a shell command, returning stdout. */
function run(cmd, options = {}) {
  const { timeout = 120_000, ...rest } = options
  try {
    return execSync(cmd, { stdio: "pipe", encoding: "utf-8", timeout, ...rest })
  } catch (e) {
    const stderr = e.stderr?.toString().trim()
    const stdout = e.stdout?.toString().trim()
    const output = [stderr, stdout].filter(Boolean).join("\n")
    throw new Error(output || e.message || "Command failed")
  }
}

/** Run a command on the Fly machine via SSH. */
function flySSH(cmd) {
  return run(`${FLY} ssh console --app ${APP_NAME} -C '${cmd.replace(/'/g, "'\\''")}'`)
}

/** Sleep for the given number of seconds. */
function sleepSync(seconds) {
  execSync(`sleep ${seconds}`, { stdio: "pipe" })
}

const secrets = readSecrets()

// Steps

const steps = {
  "check flyctl": () => {
    if (!existsSync(FLY)) {
      throw new Error("flyctl not found. Install: curl -L https://fly.io/install.sh | sh")
    }
    const whoami = run(`${FLY} auth whoami`).trim()
    if (!whoami || whoami.includes("not logged in")) {
      throw new Error("Not logged in to Fly.io. Run: fly auth login")
    }
  },

  "create app": () => {
    if (redeployOnly) return
    try {
      const apps = JSON.parse(run(`${FLY} apps list --json`))
      if (apps.some(a => a.Name === APP_NAME)) return
    } catch {}
    run(`${FLY} apps create ${APP_NAME}`)
  },

  "create volume": () => {
    if (redeployOnly) return
    try {
      const volumes = JSON.parse(run(`${FLY} volumes list --app ${APP_NAME} --json`))
      if (volumes.some(v => v.Name === VOLUME_NAME)) return
    } catch {}
    run(
      `${FLY} volumes create ${VOLUME_NAME} --size ${VOLUME_SIZE_GB} --region ${REGION} --app ${APP_NAME} -y`,
    )
  },

  "set secrets": () => {
    const flySecrets = { ANTHROPIC_API_KEY: secrets["ANTHROPIC_API_KEY"] }
    if (!flySecrets.ANTHROPIC_API_KEY) {
      throw new Error("ANTHROPIC_API_KEY not found in ~/.secrets")
    }

    for (const key of [
      "OPENAI_API_KEY",
      "BRAVE_SEARCH_API_KEY",
      "GEMINI_API_KEY",
      "GOOGLE_PLACES_API_KEY",
    ]) {
      if (secrets[key]) flySecrets[key] = secrets[key]
    }

    // Skip if all secrets are already set
    try {
      const existing = run(`${FLY} secrets list --app ${APP_NAME} --json`)
      const existingKeys = new Set(JSON.parse(existing).map(s => s.Name || s.name))
      const needed = Object.keys(flySecrets).filter(k => !existingKeys.has(k))
      if (needed.length === 0) return
    } catch {}

    const args = Object.entries(flySecrets)
      .map(([k, v]) => `${k}="${v}"`)
      .join(" ")
    run(`${FLY} secrets set ${args} --app ${APP_NAME}`)
  },

  deploy: () => {
    // Skip if already running the latest image
    try {
      const machines = JSON.parse(run(`${FLY} machines list --app ${APP_NAME} --json`))
      if (machines.length > 0 && machines[0].state === "started") {
        const currentImage = machines[0].config?.image || ""
        if (currentImage.includes("openclaw/openclaw:latest")) return
      }
    } catch {}

    const tmpDir = mkdtempSync(join(tmpdir(), "flyoc-"))
    const flyToml = `app = "${APP_NAME}"
primary_region = "${REGION}"

[env]
  NODE_ENV = "production"
  OPENCLAW_PREFER_PNPM = "1"
  OPENCLAW_STATE_DIR = "/data"
  NODE_OPTIONS = "--max-old-space-size=1536"

[processes]
  app = "node dist/index.js gateway --allow-unconfigured --port 3000 --bind lan"

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

[[vm]]
  size = "shared-cpu-2x"
  memory = "4096mb"

[mounts]
  source = "${VOLUME_NAME}"
  destination = "/data"
`
    writeFileSync(join(tmpDir, "fly.toml"), flyToml)
    run(`${FLY} deploy --image ${IMAGE} --ha=false`, {
      timeout: 300_000,
      cwd: tmpDir,
    })
  },

  "wait for machine": () => {
    for (let i = 0; i < 30; i++) {
      try {
        const status = run(`${FLY} status --app ${APP_NAME}`)
        if (status.includes("running") || status.includes("started")) return
      } catch {}
      sleepSync(2)
    }
    throw new Error("Machine did not reach running state within 60s")
  },

  "setup dev environment": () => {
    const envVars = []
    if (secrets["GITHUB_TOKEN"] || secrets["GH_TOKEN"]) {
      envVars.push(`GITHUB_TOKEN='${secrets["GITHUB_TOKEN"] || secrets["GH_TOKEN"]}'`)
    }
    const envBlock = envVars.length > 0 ? `export ${envVars.join(" ")}; ` : ""
    flySSH(
      `bash -c "${envBlock}curl -fsSL ${DEV_SETUP_URL} | npm_config_update_notifier=false npx -y tsx -"`,
    )
  },

  "setup openclaw": () => {
    // Clone marvin-bootstrap (or pull if already cloned) and run bootstrap
    const ghToken = secrets["GITHUB_TOKEN"] || secrets["GH_TOKEN"] || ""
    const repoUrl = ghToken
      ? BOOTSTRAP_REPO.replace("//github.com", `//x-access-token:${ghToken}@github.com`)
      : BOOTSTRAP_REPO

    const envVars = [
      `ANTHROPIC_API_KEY='${secrets["ANTHROPIC_API_KEY"]}'`,
      `GATEWAY_URL='${GATEWAY_URL}'`,
    ]
    if (freshToken) envVars.push("GATEWAY_TOKEN=''")
    for (const key of ["OPENAI_API_KEY", "BRAVE_SEARCH_API_KEY", "GEMINI_API_KEY", "GH_TOKEN"]) {
      if (secrets[key]) envVars.push(`${key}='${secrets[key]}'`)
    }
    const envBlock = `export ${envVars.join(" ")}`

    flySSH(
      `bash -c "cd /data && (test -d marvin-bootstrap/.git && cd marvin-bootstrap && git pull -q || git clone -q '${repoUrl}') && cd marvin-bootstrap && ${envBlock} && npx -y tsx src/bootstrap.ts"`,
    )
  },

  "open dashboard": () => {
    // Read the token from the config we just wrote
    let token = ""
    try {
      const configJson = flySSH("cat /data/openclaw.json")
      const config = JSON.parse(configJson)
      token = config.gateway?.auth?.token || ""
    } catch {}

    const dashboardUrl = token ? `${GATEWAY_URL}/#token=${token}` : GATEWAY_URL
    console.error(`  Dashboard: ${dashboardUrl}`)
    if (process.stdout.isTTY) {
      execSync(`open "${dashboardUrl}"`, { stdio: "pipe" })
    }
  },
}

// Checklist UI

const stepStatus = new Map()
let headerLines = 0

function render() {
  if (headerLines > 0) {
    process.stderr.write(`\x1b[${stepStatus.size}A`)
  }
  for (const [name, status] of stepStatus) {
    const icon =
      status === "done" ? "✓"
      : status === "warn" ? "!"
      : status === "skip" ? "−"
      : status === "running" ? "⋯"
      : "○"
    process.stderr.write(`\x1b[2K${icon} ${name}\n`)
  }
  headerLines = stepStatus.size
}

function updateStep(name, status) {
  stepStatus.set(name, status)
  render()
}

function runStep(name, fn) {
  updateStep(name, "running")
  try {
    fn()
    updateStep(name, "done")
  } catch (e) {
    updateStep(name, "warn")
    console.error()
    console.error(`\x1b[1;31mFailed at "${name}":\x1b[0m`)
    console.error(e.message)
    process.exit(1)
  }
}

// Main

console.error()
console.error("─".repeat(process.stderr.columns || 80))
console.error(`Setting up OpenClaw on Fly.io (${APP_NAME})...`)
console.error()

for (const name of Object.keys(steps)) {
  stepStatus.set(name, "pending")
}
render()

for (const [name, fn] of Object.entries(steps)) {
  runStep(name, fn)
}

console.error()
console.error("\x1b[1;32m✓\x1b[0m OpenClaw is ready!")
console.error()

process.exit(0)
