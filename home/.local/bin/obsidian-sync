#!/bin/bash
# Auto-commit and push Obsidian vault changes to git.
VAULT="/Users/herbcaudill/Code/HerbCaudill/notes"
cd "$VAULT" || exit 1

# Skip if no changes
if git diff --quiet && git diff --cached --quiet && [ -z "$(git ls-files --others --exclude-standard)" ]; then
  exit 0
fi

git add -A
git commit -m "vault sync $(date +%Y-%m-%d\ %H:%M)"
git push
