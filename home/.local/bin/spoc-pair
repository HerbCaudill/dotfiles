#!/usr/bin/env node

/**
 * Standalone pairing test for OpenClaw on a sprite.
 * Usage: spoc-pair <sprite-name>
 *
 * This script:
 * 1. Gets the sprite URL and gateway token from the running config
 * 2. Opens the dashboard
 * 3. Polls for a pending device
 * 4. Approves it if found
 *
 * Use this to debug pairing issues independently of the full spoc setup.
 */

import { execSync } from "node:child_process"

const name = process.argv[2]
if (!name) {
  console.error("Usage: spoc-pair <sprite-name>")
  process.exit(1)
}

const OC_PATH =
  "export PATH=\\$HOME/.local/bin:\\$(echo /.sprite/languages/node/nvm/versions/node/*/bin):\\$PATH"

// Step 1: Get the gateway token from the sprite's openclaw config
console.log(`[1] Reading gateway token from sprite "${name}"...`)
let gatewayToken
try {
  gatewayToken = run(
    `sprite exec -s ${name} bash -c "${OC_PATH}; cat ~/.openclaw/openclaw.json"`,
  )
  const config = JSON.parse(gatewayToken)
  gatewayToken = config.gateway?.auth?.token
  if (!gatewayToken) {
    console.error("No gateway.auth.token found in openclaw.json")
    process.exit(1)
  }
  console.log(`    Token: ${gatewayToken.slice(0, 8)}...`)
} catch (e) {
  console.error("Failed to read openclaw config:", e.message)
  process.exit(1)
}

// Step 2: Check gateway status
console.log(`[2] Checking gateway status...`)
try {
  const servicesOutput = run(
    `sprite exec -s ${name} bash -c "sprite-env services list"`,
  )
  const services = JSON.parse(servicesOutput)
  const gw = services.find(s => s.name === "openclaw-gateway")
  console.log(`    Gateway status: ${gw?.state?.status ?? "not found"}`)
} catch (e) {
  console.log(`    Could not check services: ${e.message}`)
}

// Step 3: Check current devices before opening dashboard
console.log(`[3] Current devices (before opening dashboard)...`)
listDevices(name)

// Step 4: Get sprite URL and open dashboard
console.log(`[4] Getting sprite URL...`)
const urlOutput = run(`sprite url -s ${name}`)
const spriteUrl = urlOutput
  .split("\n")
  .find(l => l.startsWith("URL:"))
  ?.replace(/^URL:\s*/, "")
  .trim()
console.log(`    Sprite URL: ${spriteUrl}`)

const dashboardUrl = `${spriteUrl}/#token=${gatewayToken}`
console.log(`    Dashboard URL: ${dashboardUrl}`)

// Check if URL is public
const authLine = urlOutput
  .split("\n")
  .find(l => l.toLowerCase().includes("auth"))
console.log(`    Auth: ${authLine?.trim() ?? "unknown"}`)

console.log(`[5] Opening dashboard in browser...`)
execSync(`open "${dashboardUrl}"`)

// Step 6: Poll for pending device
console.log(`[6] Polling for pending device...`)
console.log(`    Waiting 5s for browser to connect...`)
sleepSync(5)

for (let i = 0; i < 12; i++) {
  console.log(`    Attempt ${i + 1}/12...`)
  const devices = listDevices(name)

  if (devices.pending && devices.pending.length > 0) {
    const pendingId = devices.pending[0].requestId
    console.log(`\n[7] Found pending device! Approving ${pendingId}...`)
    try {
      const result = run(
        `sprite exec -s ${name} bash -c "${OC_PATH}; openclaw devices approve '${pendingId}'"`,
      )
      console.log(`    ${result.trim()}`)
      console.log("\nPairing successful!")
    } catch (e) {
      console.error(`    Approval failed: ${e.message}`)
    }
    process.exit(0)
  }

  if (i < 11) {
    console.log(`    No pending device yet, waiting 3s...`)
    sleepSync(3)
  }
}

console.log("\nNo pending device found after 12 attempts (~41s).")
console.log("Debug checklist:")
console.log("  - Is the dashboard actually loaded in the browser?")
console.log("  - Does the dashboard show 'Connected' status?")
console.log("  - Try refreshing the dashboard page")
console.log(`  - Dashboard URL: ${dashboardUrl}`)

// Utilities

function run(cmd) {
  return execSync(cmd, { stdio: "pipe", encoding: "utf-8" })
}

function sleepSync(seconds) {
  execSync(`sleep ${seconds}`, { stdio: "pipe" })
}

function listDevices(spriteName) {
  try {
    const output = run(
      `sprite exec -s ${spriteName} bash -c "${OC_PATH}; openclaw devices list --json"`,
    )
    const data = JSON.parse(output)
    const pending = data.pending ?? []
    const approved = data.approved ?? []
    console.log(
      `    Devices: ${approved.length} approved, ${pending.length} pending`,
    )
    if (pending.length > 0) {
      for (const p of pending) {
        console.log(`      Pending: ${p.requestId} (${p.name ?? "unnamed"})`)
      }
    }
    if (approved.length > 0) {
      for (const a of approved) {
        console.log(`      Approved: ${a.deviceId ?? a.name ?? "unnamed"}`)
      }
    }
    return data
  } catch (e) {
    console.log(`    Failed to list devices: ${e.message}`)
    return {}
  }
}
