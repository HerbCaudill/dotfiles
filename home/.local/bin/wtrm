#!/bin/bash
# wtrm <branch> [-f] [-k] - Remove worktree and branch (-k keeps branch)

if [[ -z "$1" ]]; then
  echo "Usage: wtrm <branch> [-f] [-k]" >&2
  exit 1
fi

branch="$1"
force=""
keepbranch=false
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f) force="--force" ;;
    -k) keepbranch=true ;;
  esac
  shift
done

wt_dir=$(_wt_dir) || exit 1

git worktree remove $force "$wt_dir/$branch" || exit 1
if ! $keepbranch; then
  git branch -D "$branch" 2>/dev/null
fi
