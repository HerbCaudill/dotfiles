<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.herbcaudill.beads-shared-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-lc</string>
		<string>mkdir -p "$HOME/.beads/shared-server/dolt" &amp;&amp; cd "$HOME/.beads/shared-server/dolt" &amp;&amp; { [ -d .dolt ] || /opt/homebrew/bin/dolt init; } &amp;&amp; exec /opt/homebrew/bin/dolt sql-server -H 127.0.0.1 -P 3308</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/beads-shared-server.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/beads-shared-server.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/herbcaudill/.proto/shims:/Users/herbcaudill/.proto/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
